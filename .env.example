# ============================================
# AI-Based Smart Governance & Compliance System
# ============================================

ENVIRONMENT=development

# ----- Database (Local Docker) -----
POSTGRES_USER=coalmine
POSTGRES_PASSWORD=coalmine_dev_password
POSTGRES_DB=coalmine_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ----- Database (Production Render / External) -----
# If DATABASE_URL is set, it overrides the POSTGRES_* variables.
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE

# ----- Redis -----
REDIS_URL=redis://redis:6379/0

# ----- Backend Configuration -----
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_use_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# ----- AI Inference Service -----
AI_PROVIDER=local
AI_BASE_URL=http://model-server:8001/v1
AI_MODEL=coal-gov-qwen3-4b

# ----- GPU Model Server (model-server) -----
MODEL_NAME=Qwen/Qwen3-4B
ADAPTER_PATH=/models/coal-gov-4b
MODEL_ALIAS=coal-gov-qwen3-4b

# ----- Frontend (if built dynamically) -----
VITE_API_URL=http://localhost:8002/api/v1

# ----- OAuth Settings -----
# FRONTEND_URL MUST perfectly match your frontend deployment URL (no trailing slash).
# The redirect URI registered in Google Cloud Console must be EXACTLY: \\/auth/callback\
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
